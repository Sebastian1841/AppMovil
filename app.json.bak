{
  "expo": {
    "name": "Sinergy GPS Fuel",
    "slug": "sinergy-gps-fuel-app",
    "scheme": "sinergygpsfuel",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-your-own-project-id-if-you-use-eas"
      }
    }
  }
}